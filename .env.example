VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
# Required for the maps in the booking flow — the route drawn on screen and
# its static fallback. Falls back to a drawn sketch of the island when unset.
VITE_MAPBOX_TOKEN=
# Optional — live address search in the booking card and picker (falls back
# to "type it, pick your area" when unset). Needs "Places API (New)" enabled
# on a Google Cloud project with billing on, and the key restricted by HTTP
# referrer to this site's own domain(s) — never ship an unrestricted key.
# Vite inlines this at BUILD time, so setting it on the host after the fact
# does nothing until the next deploy.
VITE_GOOGLE_PLACES_KEY=
# Optional — payment goes live only when these are set
VITE_STRIPE_PUBLISHABLE_KEY=
STRIPE_SECRET_KEY=
