VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
# The domain this build is served from, no trailing slash. Substituted
# into index.html's canonical link, og:url and the two image URLs, which
# have to be absolute for a link preview to resolve. Unset, it falls back
# to https://cabbys.aw — so set this the day the real domain is bought.
VITE_SITE_URL=
# One Google Maps Platform key, shared by everything map-related: live
# address search in the booking card and picker, the interactive route map,
# its static-image fallback, and the driving line drawn on both. Falls back
# to "type it, pick your area" and a drawn sketch of the island when unset.
# On the Google Cloud project this key belongs to, enable "Places API
# (New)", "Maps JavaScript API", "Maps Static API" and "Routes API", turn
# on billing, and restrict the key by HTTP referrer to this site's own
# domain(s) — never ship an unrestricted key.
# Vite inlines this at BUILD time, so setting it on the host after the fact
# does nothing until the next deploy.
VITE_GOOGLE_PLACES_KEY=
# Optional — payment goes live only when these are set
VITE_STRIPE_PUBLISHABLE_KEY=
STRIPE_SECRET_KEY=
